# Copy this file to ".env" and set your backend URL.
# Must include the /api suffix (same as the web client's VITE_BACKEND_URL).
#
# Physical phone on same Wi-Fi (use your PC's LAN IP from ipconfig):
#   EXPO_PUBLIC_API_URL=http://192.168.1.15:3000/api
#
# Android emulator with adb in PATH (optional):
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api
#
# Production:
#   EXPO_PUBLIC_API_URL=https://api.wemakeover.co.in/api

EXPO_PUBLIC_API_URL=http://192.168.1.15:3000/api

# MSG91 SendOTP widget (Account phone update). Restart Metro after change.
EXPO_PUBLIC_MSG91_WIDGET_ID=366944737148363932373136
EXPO_PUBLIC_MSG91_AUTH_TOKEN=
