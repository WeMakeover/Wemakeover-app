# Copy to .env and fill in real values. Never commit .env to git.

# ── Neon PostgreSQL (sole app database) ──────────────────────────────────────
# Pooled URL for the running API; direct (no -pooler) for Prisma migrate
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Optional pool tuning
# PG_POOL_MAX=10
# PG_IDLE_TIMEOUT_MS=30000
# PG_CONNECT_TIMEOUT_MS=10000

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000
APP_NAME=Wemakeover
SUPPORT_EMAIL=hello@wemakeover.co.in
SUPPORT_PHONE=

# ── JWT (use long random strings in production) ──────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_SECRET=change-me-reset-secret-min-32-chars

# ── Redis (OTP, password-reset, sessions) — required in production ───────────
# Prefer REDIS_URL on Render/Upstash. Otherwise use host/port/password.
# REDIS_URL=redis://default:PASSWORD@host:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ── MSG91 (phone OTP) ────────────────────────────────────────────────────────
MSG91_AUTH_KEY=

# ── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ── Razorpay (payments) ──────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Cloudinary (images) ──────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
IMAGE_UPLOAD_PROVIDER=cloudinary
# MAX_FILE_SIZE=5242880

# ── Optional: AWS S3 instead of / in addition to Cloudinary ──────────────────
# IMAGE_UPLOAD_PROVIDER=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_S3_BUCKET_NAME=

# ── Email ────────────────────────────────────────────────────────────────────
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=

# ── Firebase Cloud Messaging (push) — optional ───────────────────────────────
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Or inline JSON / split fields:
# FIREBASE_SERVICE_ACCOUNT=
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# ── Referrals (optional) ─────────────────────────────────────────────────────
# REFERRAL_REWARD_AMOUNT=
# REFERRAL_MILESTONE_BONUS_AMOUNT=
# REFERRAL_SHARE_BASE_URL=https://wemakeover.co.in
# REFERRAL_APP_SCHEME=wemakeover

# ── Seed admin (npm run seed:admin) ──────────────────────────────────────────
# SEED_ADMIN_NAME=Admin
# ADMIN_EMAIL=admin@wemakeover.co.in
# SEED_ADMIN_PASSWORD=
# ADMIN_PHONE_NUMBER=
